<ul class="facet-values list-unstyled">
  <% 
    limit = facet_field.limit || 5
    limited_items = display_facet.items.first(limit)
    has_more = display_facet.items.length > limit
  %>
  <% limited_items.each do |item| %>
    <li>
      <span class="facet-label">
        <%= link_to item.label, search_action_path(:"f[#{facet_field.key}][]" => item.value), 
          class: "facet-select", rel: "nofollow" %>
      </span>
      <span class="facet-count" style="<%= 'width: 2ch;' if item.hits < 10 %>">
        <%= item.hits %>
      </span>
    </li>
  <% end %>

  <% if has_more && params[:action] != "facet" %>
    <li class="more_facets_link">
      <%= link_to t("more_#{field_name}_html", scope: 'blacklight.search.facets', default: :more_html, field_name: facet_field.label),
        main_app.facet_catalog_path(id: facet_field.key),
        class: 'more_facets_link' %>
    </li>
  <% end %>
</ul>
