<ul class="facet-values list-unstyled">
  <% paginator = facet_paginator(facet_field, display_facet) %>
  <%= render_facet_limit_list paginator, facet_field.key %>

  <% unless paginator.last_page? || params[:action] == "facet" %>
    <li class="more_facets_link">
      <%= button_tag t("more_#{field_name}_html", scope: 'blacklight.search.facets', default: :more_html, field_name: facet_field.label),
        class: 'more_facets_link btn btn-link p-0',
        data: { toggle: 'modal', target: "#facet-modal-#{facet_field.key}" } %>
    </li>
  <% end %>
</ul>

<!-- Render Facet Modal -->
<%= render 'facet_modal', facet_field: facet_field, display_facet: display_facet, field_name: field_name %>
